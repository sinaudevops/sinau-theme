{{- $.Scratch.Add "index" slice -}}
{{- range where .Site.RegularPages "Type" "in" (slice "posts") -}}
    {{- $.Scratch.Add "index" (dict "title" .Title "permalink" .Permalink "summary" (.Summary | plainify | truncate 200) "content" (.Content | plainify | truncate 500) "categories" (.GetTerms "categories" | default slice)) -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
